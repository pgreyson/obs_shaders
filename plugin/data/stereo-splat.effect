// stereo-splat.effect — forward splat with ATTRIBUTE-STREAMED data.
// All math mirrors tools/stereo_oracle.py render_eyes() bit-for-bit:
// change both together.
//
// NO texture access happens in any vertex shader here: Apple's GL-on-
// Metal driver returns constant black for vertex-stage sampling
// (texture/textureLod/texelFetch all measured broken with verified
// bindings), and OBS's Metal backend can't compile obs-shaderfilter, so
// the rig is pinned to GL. Instead the C side streams the bake output
// into the COLOR attribute every frame: rgb = splat color, a = encoded
// depth (a = 0.5 + d/2). The vertical crop row mapping is also applied
// CPU-side during that fill.
//
// Vertex encoding:
//   POSITION: x = source-x in [0,1] uv (subsample center for splat,
//             pixel center for warp), y = OUTPUT row, z = warp edge flag
//             (0 top, 1 bottom)
//   COLOR:    the source texel for this vertex (rgb color, a depth)
//
// Depth convention: d in [0,1], larger = nearer. libobs ortho is
// RIGHT-HANDED (NDC z = -z_world/100 under gs_ortho(...,-100,100)), so
// world z = -100 + d*200 puts near content at the SMALLEST window depth;
// GS_LEQUAL + ascending-x draw order = the oracle's stable-sort
// largest-x tie-break.

#define PIC_LO 0.010
#define PIC_HI 0.985

uniform float4x4 ViewProj;
uniform texture2d image;  // fragment-stage use only (warp color, blits)

uniform float2 dims;     // source width, height
uniform float eye_sign;  // +1 = L, -1 = R (crossed disparity)
uniform float eye_base;  // 0 (L) or eye_w (R) in output pixels
uniform float eye_w;     // dims.x / 2
uniform float f0;        // per-eye displacement per unit depth (source u)
			 //   = thickness_px * span / (2 * 1920)
uniform float inset;     // fixed frame inset (source u), from frame_inset_px
uniform float vis_lo;    // PIC_LO + inset
uniform float span;      // (PIC_HI - inset) - vis_lo
uniform float window_on; // 1 = floating window (no edge taper)
uniform float fill_px;   // micro-fill: gaps <= this many px (0 = off)
uniform float mlaa_on;   // reveal-edge MLAA in the present pass
uniform float shift0;    // per-eye constant shift (source u)
			 //   = (anchor*thickness_px - plane_px) * span / (2 * 1920)
			 // displayed disparity (L-R, px at 1920/eye) of depth dt:
			 //   plane_px + thickness_px * (dt - anchor)

uniform float anchor_d;  // anchor depth (0 back .. 1 front): what the vignette flattens to
uniform float vig_w;     // depth vignette ramp width, fraction of the visible frame (0 = off)
uniform float out_rows;  // rows in the vertex grid (output height incl. supersampling)
uniform float smooth_sigma; // field smoothing sigma (source px, 0 = off)
uniform float2 smooth_step; // one texel along the blur axis (uv)
uniform float smooth_lit;   // 1 = black pixels carry no weight in the smoothing

sampler_state pointSampler {
	Filter    = Point;
	AddressU  = Clamp;
	AddressV  = Clamp;
};

sampler_state linearSampler {
	Filter    = Linear;
	AddressU  = Clamp;
	AddressV  = Clamp;
};

struct VertIn {
	float4 pos : POSITION;
	float4 col : COLOR;
};

struct SplatOut {
	float4 pos : POSITION;
	float4 col : COLOR;
	float zenc : TEXCOORD1; // 0.5 + dt/2; becomes output alpha (fill
				// pass picks the FARTHER flank by it;
				// cleared alpha 0 = unwritten reveal)
};

struct WarpOut {
	float4 pos : POSITION;
	float2 uv  : TEXCOORD0;
};

// Oracle edge_taper(): dead zone (width f0) of zero disparity at the
// view edges, then a smoothstep ramp to full depth inward. Floating
// window mode disables it (full depth to the frame edge).
float edge_taper(float x)
{
	if (window_on > 0.5 || f0 <= 0.0)
		return 1.0;
	float d = min(x - (PIC_LO + inset), (PIC_HI - inset) - x) - f0;
	float t = clamp(d / (1.5 * f0 + 0.001), 0.0, 1.0);
	return t * t * (3.0 - 2.0 * t);
}

// DEPTH VIGNETTE (not in the oracle; 0 = off = oracle-identical): depth
// relative to the anchor is scaled by a smoothstep that is 0 at the LEFT and
// RIGHT frame edges and 1 once vig_w of the frame inward. At those edges the
// field is flat at plane_px, so the frame never fights the depth and the
// floating window (which sits at plane_px) is exact there.
// Sides only: it used to ramp at the top and bottom too, where horizontal
// parallax has no frame conflict to solve, and there it bent every vertical
// edge, opposite ways in the two eyes (measured: 60 px at thickness 250).
float vignette(float u, float row)
{
	if (vig_w <= 0.0)
		return 1.0;
	float hx = min(u - vis_lo, (vis_lo + span) - u) / span;
	float a = clamp(hx / vig_w, 0.0, 1.0);
	return a * a * (3.0 - 2.0 * a);
}
float shape(float d, float u, float row)
{
	return anchor_d + (d * edge_taper(u) - anchor_d) * vignette(u, row);
}

// Oracle vertical crop (needed only for the warp fragment uv; the splat
// COLOR stream already had it applied CPU-side).
float src_row(float out_row)
{
	float sr = floor((inset + (out_row + 0.5) / dims.y * (1.0 - 2.0 * inset)) *
			 dims.y);
	return clamp(sr, 0.0, dims.y - 1.0);
}

// v19 pixel-footprint line splat: each vertex is one END of a source
// pixel's footprint line (pos.x = pixel EDGE u, pos.z = pixel CENTER u).
// The endpoint is snapped to its dest bin and extended half-open
// ([b_left, b_right+1)) so GL line rasterization covers exactly the
// oracle's inclusive bin range. Whole-pixel validity (PIC crop) tests
// the CENTER; per-eye scissor (C side) clips off-eye/folded spans.
SplatOut VSSplat(VertIn v_in)
{
	SplatOut v_out;
	float u_edge = v_in.pos.x;
	float u_c = v_in.pos.z;
	float d = clamp(2.0 * (v_in.col.a - 0.5), 0.0, 1.0);
	float dt_e = shape(d, u_edge, v_in.pos.y);
	float dest = u_edge + eye_sign * (dt_e * f0 - shift0);
	float q = (dest - vis_lo) / span;
	// +5e-4 px epsilon inside the floor: shared bin-boundary
	// convention with the oracle (f32-vs-f64 lattice dust); change
	// both together.
	float b = floor(q * eye_w + 5.0e-4);
	bool right_end = (u_edge > u_c);
	float out_x = eye_base + b + (right_end ? 1.0 : 0.0);
	float out_y = v_in.pos.y + 0.5;
	bool ok = (u_c >= PIC_LO) && (u_c <= PIC_HI);
	// z-buffer key = depth tapered at the pixel CENTER (constant along
	// the line, matching the oracle's scalar per-pixel sort key).
	float dt_c = shape(d, u_c, v_in.pos.y);
	float zw = ok ? (-100.0 + dt_c * 200.0) : 10000.0;
	v_out.pos = mul(float4(out_x, out_y, zw, 1.0), ViewProj);
	v_out.col = float4(v_in.col.rgb, 1.0);
	v_out.zenc = 0.5 + 0.5 * dt_c;
	return v_out;
}

SplatOut VSDebug(VertIn v_in)
{
	SplatOut v_out = VSSplat(v_in);
	float d = clamp(2.0 * (v_in.col.a - 0.5), 0.0, 1.0);
	v_out.col = float4(d, d, d, 1.0);
	return v_out;
}

// Warp: continuous destination (no binning) so the rasterizer stretches
// the surface across disocclusions; color is sampled in the FRAGMENT at
// the interpolated source u, so stretched spans resample smoothly.
WarpOut VSWarp(VertIn v_in)
{
	WarpOut v_out;
	float u = clamp(v_in.pos.x, PIC_LO, PIC_HI);
	float out_row = v_in.pos.y;
	float d = clamp(2.0 * (v_in.col.a - 0.5), 0.0, 1.0);
	float dt = shape(d, u, out_row);
	float dest = u + eye_sign * (dt * f0 - shift0);
	float q = (dest - vis_lo) / span;
	float out_x = eye_base + clamp(q, 0.0, 1.0) * eye_w;
	float out_y = out_row + v_in.pos.z; // z flag: 0 top, 1 bottom

	float zw = -100.0 + d * 200.0;
	v_out.pos = mul(float4(out_x, out_y, zw, 1.0), ViewProj);
	v_out.uv = float2(u, (src_row(out_row) + 0.5) / dims.y);
	return v_out;
}

// Warp on a COARSE connected mesh (mesh_step > 1): vertices every N source
// px in x and every N output rows in y, joined in both directions, so depth
// is interpolated between them. pos.y is the vertex's output y (a row
// boundary), pos.z unused. Colour is still sampled per fragment from the
// full-resolution picture, so only the DISPLACEMENT is coarser, and with a
// smoothed depth field that is not visible. 1/N^2 of the vertices: the
// per-pixel mesh (8.3 M vertices a frame for both eyes) was the largest
// single GPU load of the rig (measured 2026-11-21).
WarpOut VSWarpMesh(VertIn v_in)
{
	WarpOut v_out;
	float u = clamp(v_in.pos.x, PIC_LO, PIC_HI);
	float y = v_in.pos.y;
	float d = clamp(2.0 * (v_in.col.a - 0.5), 0.0, 1.0);
	float dt = shape(d, u, y - 0.5);
	float dest = u + eye_sign * (dt * f0 - shift0);
	float q = (dest - vis_lo) / span;
	float out_x = eye_base + clamp(q, 0.0, 1.0) * eye_w;

	float zw = -100.0 + d * 200.0;
	v_out.pos = mul(float4(out_x, y, zw, 1.0), ViewProj);
	// continuous form of src_row(): at a fragment centre (row + 0.5) the
	// point sampler lands on the same source row
	v_out.uv = float2(u, inset + (y / dims.y) * (1.0 - 2.0 * inset));
	return v_out;
}

// DebugQ: paint each source pixel's q*eye_w (the continuous dest bin
// coordinate, before floor) as 24-bit fixed point AT THE SOURCE COLUMN,
// subsample 0 only — lets the harness read the GPU's own arithmetic.
SplatOut VSDebugQ(VertIn v_in)
{
	SplatOut v_out;
	float u_sub = v_in.pos.x;
	float d = clamp(2.0 * (v_in.col.a - 0.5), 0.0, 1.0);
	float dt = shape(d, u_sub, v_in.pos.y);
	float dest = u_sub + eye_sign * (dt * f0 - shift0);
	float q = (dest - vis_lo) / span;
	float v = q * eye_w; // the value under test

	float src_px = floor(u_sub * eye_w);
	// keep only subsample 0 of each source pixel pair (2 src px per
	// eye px at half-SBS — keep the first)
	float idx = u_sub * dims.x * 4.0; // global subsample index
	bool keep = frac(floor(idx) / 8.0) < 0.01; // every 8th subsample
	float out_x = eye_base + src_px + 0.5;
	float out_y = v_in.pos.y + 0.5;
	float zw = keep ? 0.0 : 10000.0;
	v_out.pos = mul(float4(out_x, out_y, zw, 1.0), ViewProj);
	float k = clamp(v / 1024.0, 0.0, 0.999999);
	float r = floor(k * 256.0);
	float g = floor(k * 65536.0) - r * 256.0;
	float b = floor(k * 16777216.0) - floor(k * 65536.0) * 256.0;
	v_out.col = float4(r / 255.0, g / 255.0, b / 255.0, 1.0);
	v_out.zenc = 1.0;
	return v_out;
}

float4 PSSplat(SplatOut v_in) : TARGET
{
	// alpha = encoded tapered depth: the fill pass needs per-pixel z
	// to continue the FARTHER flank; the present pass forces alpha
	// back to 1. Cleared (unwritten) pixels keep alpha 0 = reveal.
	return float4(v_in.col.rgb, v_in.zenc);
}

float4 PSWarp(WarpOut v_in) : TARGET
{
	// POINT sampling: stretch zones replicate pixels instead of blending
	// them — hard color edges stay hard while the disparity ramp under
	// them is smooth. (Linear washed every contact into in-between
	// colors; measured/rejected as smear.) Matches render_eyes_warp.
	float4 texel = image.SampleLevel(pointSampler, v_in.uv, 0.0);
	return float4(texel.rgb, 1.0);
}

// ---- debug blits (sprite-drawn, standard pos+uv inputs) ----
struct SpriteIn {
	float4 pos : POSITION;
	float2 uv  : TEXCOORD0;
};

WarpOut VSSprite(SpriteIn v_in)
{
	WarpOut v_out;
	v_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
	v_out.uv = v_in.uv;
	return v_out;
}

float4 PSBlitRGB(WarpOut v_in) : TARGET
{
	float4 texel = image.SampleLevel(pointSampler, v_in.uv, 0.0);
	return float4(texel.rgb, 1.0);
}

float4 PSBlitA(WarpOut v_in) : TARGET
{
	float4 texel = image.SampleLevel(pointSampler, v_in.uv, 0.0);
	return float4(texel.a, texel.a, texel.a, 1.0);
}

// micro-fill post-pass (sprite-drawn over the splat texrender): reveal
// runs no wider than fill_px are texture-scale disocclusions — continue
// the FARTHER flank (smaller encoded z). Wider gaps stay backdrop per
// the v10 rigid-shape rule. Mirrors render_eyes(micro_fill=...).
float4 PSFill(WarpOut v_in) : TARGET
{
	float4 c = image.SampleLevel(pointSampler, v_in.uv, 0.0);
	if (fill_px < 0.5 || c.a >= 0.25)
		return c;
	float tw = 1.0 / dims.x;
	float lo = (v_in.uv.x < 0.5) ? 0.0 : 0.5; // stay inside this eye
	float hi = lo + 0.5;
	float dl = 0.0;
	float dr = 0.0;
	float4 cl = c;
	float4 cr = c;
	for (int k = 1; k <= 5; k++) {
		float fk = float(k);
		float xl = v_in.uv.x - fk * tw;
		if (dl < 0.5 && xl > lo) {
			float4 sl2 = image.SampleLevel(pointSampler,
						       float2(xl, v_in.uv.y),
						       0.0);
			if (sl2.a >= 0.25) {
				dl = fk;
				cl = sl2;
			}
		}
		float xr = v_in.uv.x + fk * tw;
		if (dr < 0.5 && xr < hi) {
			float4 sr2 = image.SampleLevel(pointSampler,
						       float2(xr, v_in.uv.y),
						       0.0);
			if (sr2.a >= 0.25) {
				dr = fk;
				cr = sr2;
			}
		}
	}
	if (dl > 0.5 && dr > 0.5 && (dl + dr - 1.0) <= fill_px) {
		// farther flank = smaller encoded z; tie -> LEFT (oracle)
		return (cl.a <= cr.a) ? cl : cr;
	}
	return c;
}

// vertical micro-fill: displacement is horizontal-only, so a thin
// unwritten run bounded by written rows is never a legitimate reveal —
// it is row-to-row displacement SHEAR on fine horizontal texture. Same
// farther-flank donor rule as PSFill, vertical taps, frame-clamped.
// Mirrors the oracle's vertical pass — change together. dims here =
// (texture width, texture HEIGHT incl. supersampling).
float4 PSFillV(WarpOut v_in) : TARGET
{
	float4 c = image.SampleLevel(pointSampler, v_in.uv, 0.0);
	if (fill_px < 0.5 || c.a >= 0.25)
		return c;
	float th = 1.0 / dims.y;
	float lo = 0.5 * th;
	float hi = 1.0 - 0.5 * th;
	float du = 0.0;
	float dd = 0.0;
	float4 cu = c;
	float4 cd = c;
	for (int k = 1; k <= 5; k++) {
		float fk = float(k);
		float yu = v_in.uv.y - fk * th;
		if (du < 0.5 && yu > lo) {
			float4 su = image.SampleLevel(pointSampler,
						      float2(v_in.uv.x, yu),
						      0.0);
			if (su.a >= 0.25) {
				du = fk;
				cu = su;
			}
		}
		float yd = v_in.uv.y + fk * th;
		if (dd < 0.5 && yd < hi) {
			float4 sd = image.SampleLevel(pointSampler,
						      float2(v_in.uv.x, yd),
						      0.0);
			if (sd.a >= 0.25) {
				dd = fk;
				cd = sd;
			}
		}
	}
	if (du > 0.5 && dd > 0.5 && (du + dd - 1.0) <= fill_px) {
		return (cu.a <= cd.a) ? cu : cd; // farther flank; tie -> up
	}
	return c;
}

technique FillV
{
	pass
	{
		vertex_shader = VSSprite(v_in);
		pixel_shader  = PSFillV(v_in);
	}
}

// present: downsample the (possibly 2x-tall) buffer to output height —
// one LINEAR tap at the output row center lands exactly between the two
// sub-rows = box filter — and force alpha to 1 (z rode in alpha).
// With mlaa_on (1x buffers): REVEAL-EDGE MLAA — vertical [1,2,1]/4 blend
// ONLY where the written sentinel (alpha >= 0.25) changes vertically,
// i.e. exactly along reveal staircase boundaries; content edges are
// never touched. Mirrors render_eyes(mlaa=True) — change together.
float4 PSPresent(WarpOut v_in) : TARGET
{
	float4 texel = image.SampleLevel(linearSampler, v_in.uv, 0.0);
	if (mlaa_on > 0.5) {
		float th = 1.0 / dims.y;
		float yu = max(v_in.uv.y - th, 0.5 * th);
		float yd = min(v_in.uv.y + th, 1.0 - 0.5 * th);
		float4 cu = image.SampleLevel(pointSampler,
					      float2(v_in.uv.x, yu), 0.0);
		float4 cd = image.SampleLevel(pointSampler,
					      float2(v_in.uv.x, yd), 0.0);
		float4 cc = image.SampleLevel(pointSampler, v_in.uv, 0.0);
		bool mc = cc.a >= 0.25;
		bool mu = cu.a >= 0.25;
		bool md = cd.a >= 0.25;
		if (mu != mc || md != mc) {
			float3 blend = (cu.rgb + 2.0 * cc.rgb + cd.rgb)
				       * 0.25;
			return float4(blend, 1.0);
		}
		return float4(cc.rgb, 1.0);
	}
	return float4(texel.rgb, 1.0);
}

// ---- field smoothing: Gaussian blur of the baked depth (alpha) only ----
// The same kernel as chromadepth_smooth.shader / stereo_oracle.field_smooth()
// (21 taps, sigma_eff^2 = round(2 sigma^2)/2, taps stride above sigma 3 so they
// cover +-3 sigma, edge-clamped, linear taps), run as two passes (h, then v)
// into RGBA8 targets, so the 8-bit steps between the passes are the same as
// when these were two obs-shaderfilter filters. Inside the plugin a pass costs
// about 0.5 ms; as a separate filter it cost 2.2 ms. dims = texture size.
float4 PSSmooth(WarpOut v_in) : TARGET
{
	float4 center = image.SampleLevel(pointSampler, v_in.uv, 0.0);
	float n = round(2.0 * smooth_sigma * smooth_sigma);
	if (n < 0.5)
		return center;
	float sig2 = n * 0.5;
	float2 lo = float2(0.5 / dims.x, 0.5 / dims.y);
	float2 hi = float2(1.0, 1.0) - lo;
	float spacing = max(1.0, smooth_sigma / 3.0);
	float acc = 0.0;
	float wsum = 0.0;
	for (int i = -10; i <= 10; i++) {
		float fi = float(i) * spacing;
		float w = exp(-(fi * fi) / (2.0 * sig2));
		float2 t = clamp(v_in.uv + fi * smooth_step, lo, hi);
		float4 tap = image.SampleLevel(linearSampler, t, 0.0);
		// "Black has no depth": a pixel with nothing to show must not
		// pull its lit neighbours toward the back plane (the bake gives
		// black depth 0), and takes its own depth from them instead.
		// Without this every fade to black is a depth slope: stripes
		// leaned as they dimmed, opposite ways in the two eyes.
		if (smooth_lit > 0.5)
			w *= 0.002 + smoothstep(0.06, 0.16,
						max(tap.r, max(tap.g, tap.b)));
		acc += w * tap.a;
		wsum += w;
	}
	return float4(center.rgb, acc / wsum);
}

technique Smooth
{
	pass
	{
		vertex_shader = VSSprite(v_in);
		pixel_shader  = PSSmooth(v_in);
	}
}

technique WarpMesh
{
	pass
	{
		vertex_shader = VSWarpMesh(v_in);
		pixel_shader  = PSWarp(v_in);
	}
}

technique Fill
{
	pass
	{
		vertex_shader = VSSprite(v_in);
		pixel_shader  = PSFill(v_in);
	}
}

technique Present
{
	pass
	{
		vertex_shader = VSSprite(v_in);
		pixel_shader  = PSPresent(v_in);
	}
}

technique Splat
{
	pass
	{
		vertex_shader = VSSplat(v_in);
		pixel_shader  = PSSplat(v_in);
	}
}

technique Warp
{
	pass
	{
		vertex_shader = VSWarp(v_in);
		pixel_shader  = PSWarp(v_in);
	}
}

technique Debug
{
	pass
	{
		vertex_shader = VSDebug(v_in);
		pixel_shader  = PSSplat(v_in);
	}
}

technique BlitRGB
{
	pass
	{
		vertex_shader = VSSprite(v_in);
		pixel_shader  = PSBlitRGB(v_in);
	}
}

technique BlitA
{
	pass
	{
		vertex_shader = VSSprite(v_in);
		pixel_shader  = PSBlitA(v_in);
	}
}

technique DebugQ
{
	pass
	{
		vertex_shader = VSDebugQ(v_in);
		pixel_shader  = PSSplat(v_in);
	}
}
