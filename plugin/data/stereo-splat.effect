// stereo-splat.effect — forward splat with ATTRIBUTE-STREAMED data.
// All math mirrors tools/stereo_oracle.py render_eyes() bit-for-bit:
// change both together.
//
// NO texture access happens in any vertex shader here: Apple's GL-on-
// Metal driver returns constant black for vertex-stage sampling
// (texture/textureLod/texelFetch all measured broken with verified
// bindings), and OBS's Metal backend can't compile obs-shaderfilter, so
// the rig is pinned to GL. Instead the C side streams the bake output
// into the COLOR attribute every frame: rgb = splat color, a = encoded
// depth (a = 0.5 + d/2). The vertical crop row mapping is also applied
// CPU-side during that fill.
//
// Vertex encoding:
//   POSITION: x = source-x in [0,1] uv (subsample center for splat,
//             pixel center for warp), y = OUTPUT row, z = warp edge flag
//             (0 top, 1 bottom)
//   COLOR:    the source texel for this vertex (rgb color, a depth)
//
// Depth convention: d in [0,1], larger = nearer. libobs ortho is
// RIGHT-HANDED (NDC z = -z_world/100 under gs_ortho(...,-100,100)), so
// world z = -100 + d*200 puts near content at the SMALLEST window depth;
// GS_LEQUAL + ascending-x draw order = the oracle's stable-sort
// largest-x tie-break.

#define PIC_LO 0.010
#define PIC_HI 0.985

uniform float4x4 ViewProj;
uniform texture2d image;  // fragment-stage use only (warp color, blits)

uniform float2 dims;     // source width, height
uniform float eye_sign;  // +1 = L, -1 = R (crossed disparity)
uniform float eye_base;  // 0 (L) or eye_w (R) in output pixels
uniform float eye_w;     // dims.x / 2
uniform float f0;        // depth_slider^2 * MAX_PARALLAX
uniform float vis_lo;    // PIC_LO + f0
uniform float span;      // (PIC_HI - f0) - vis_lo
uniform float window_on; // 1 = floating window (no edge taper)

sampler_state pointSampler {
	Filter    = Point;
	AddressU  = Clamp;
	AddressV  = Clamp;
};

sampler_state linearSampler {
	Filter    = Linear;
	AddressU  = Clamp;
	AddressV  = Clamp;
};

struct VertIn {
	float4 pos : POSITION;
	float4 col : COLOR;
};

struct SplatOut {
	float4 pos : POSITION;
	float4 col : COLOR;
};

struct WarpOut {
	float4 pos : POSITION;
	float2 uv  : TEXCOORD0;
};

// Oracle edge_taper(): dead zone (width f0) of zero disparity at the
// view edges, then a smoothstep ramp to full depth inward. Floating
// window mode disables it (full depth to the frame edge).
float edge_taper(float x)
{
	if (window_on > 0.5 || f0 <= 0.0)
		return 1.0;
	float d = min(x - (PIC_LO + f0), (PIC_HI - f0) - x) - f0;
	float t = clamp(d / (1.5 * f0 + 0.001), 0.0, 1.0);
	return t * t * (3.0 - 2.0 * t);
}

// Oracle vertical crop (needed only for the warp fragment uv; the splat
// COLOR stream already had it applied CPU-side).
float src_row(float out_row)
{
	float sr = floor((f0 + (out_row + 0.5) / dims.y * (1.0 - 2.0 * f0)) *
			 dims.y);
	return clamp(sr, 0.0, dims.y - 1.0);
}

// v19 pixel-footprint line splat: each vertex is one END of a source
// pixel's footprint line (pos.x = pixel EDGE u, pos.z = pixel CENTER u).
// The endpoint is snapped to its dest bin and extended half-open
// ([b_left, b_right+1)) so GL line rasterization covers exactly the
// oracle's inclusive bin range. Whole-pixel validity (PIC crop) tests
// the CENTER; per-eye scissor (C side) clips off-eye/folded spans.
SplatOut VSSplat(VertIn v_in)
{
	SplatOut v_out;
	float u_edge = v_in.pos.x;
	float u_c = v_in.pos.z;
	float d = clamp(2.0 * (v_in.col.a - 0.5), 0.0, 1.0);
	float dt_e = d * edge_taper(u_edge);
	float dest = u_edge + eye_sign * dt_e * f0;
	float q = (dest - vis_lo) / span;
	// +5e-4 px epsilon inside the floor: shared bin-boundary
	// convention with the oracle (f32-vs-f64 lattice dust); change
	// both together.
	float b = floor(q * eye_w + 5.0e-4);
	bool right_end = (u_edge > u_c);
	float out_x = eye_base + b + (right_end ? 1.0 : 0.0);
	float out_y = v_in.pos.y + 0.5;
	bool ok = (u_c >= PIC_LO) && (u_c <= PIC_HI);
	// z-buffer key = depth tapered at the pixel CENTER (constant along
	// the line, matching the oracle's scalar per-pixel sort key).
	float dt_c = d * edge_taper(u_c);
	float zw = ok ? (-100.0 + dt_c * 200.0) : 10000.0;
	v_out.pos = mul(float4(out_x, out_y, zw, 1.0), ViewProj);
	v_out.col = float4(v_in.col.rgb, 1.0);
	return v_out;
}

SplatOut VSDebug(VertIn v_in)
{
	SplatOut v_out = VSSplat(v_in);
	float d = clamp(2.0 * (v_in.col.a - 0.5), 0.0, 1.0);
	v_out.col = float4(d, d, d, 1.0);
	return v_out;
}

// Warp: continuous destination (no binning) so the rasterizer stretches
// the surface across disocclusions; color is sampled in the FRAGMENT at
// the interpolated source u, so stretched spans resample smoothly.
WarpOut VSWarp(VertIn v_in)
{
	WarpOut v_out;
	float u = clamp(v_in.pos.x, PIC_LO, PIC_HI);
	float out_row = v_in.pos.y;
	float d = clamp(2.0 * (v_in.col.a - 0.5), 0.0, 1.0);
	float dt = d * edge_taper(u);
	float dest = u + eye_sign * dt * f0;
	float q = (dest - vis_lo) / span;
	float out_x = eye_base + clamp(q, 0.0, 1.0) * eye_w;
	float out_y = out_row + v_in.pos.z; // z flag: 0 top, 1 bottom

	float zw = -100.0 + d * 200.0;
	v_out.pos = mul(float4(out_x, out_y, zw, 1.0), ViewProj);
	v_out.uv = float2(u, (src_row(out_row) + 0.5) / dims.y);
	return v_out;
}

// DebugQ: paint each source pixel's q*eye_w (the continuous dest bin
// coordinate, before floor) as 24-bit fixed point AT THE SOURCE COLUMN,
// subsample 0 only — lets the harness read the GPU's own arithmetic.
SplatOut VSDebugQ(VertIn v_in)
{
	SplatOut v_out;
	float u_sub = v_in.pos.x;
	float d = clamp(2.0 * (v_in.col.a - 0.5), 0.0, 1.0);
	float dt = d * edge_taper(u_sub);
	float dest = u_sub + eye_sign * dt * f0;
	float q = (dest - vis_lo) / span;
	float v = q * eye_w; // the value under test

	float src_px = floor(u_sub * eye_w);
	// keep only subsample 0 of each source pixel pair (2 src px per
	// eye px at half-SBS — keep the first)
	float idx = u_sub * dims.x * 4.0; // global subsample index
	bool keep = frac(floor(idx) / 8.0) < 0.01; // every 8th subsample
	float out_x = eye_base + src_px + 0.5;
	float out_y = v_in.pos.y + 0.5;
	float zw = keep ? 0.0 : 10000.0;
	v_out.pos = mul(float4(out_x, out_y, zw, 1.0), ViewProj);
	float k = clamp(v / 1024.0, 0.0, 0.999999);
	float r = floor(k * 256.0);
	float g = floor(k * 65536.0) - r * 256.0;
	float b = floor(k * 16777216.0) - floor(k * 65536.0) * 256.0;
	v_out.col = float4(r / 255.0, g / 255.0, b / 255.0, 1.0);
	return v_out;
}

float4 PSSplat(SplatOut v_in) : TARGET
{
	return v_in.col;
}

float4 PSWarp(WarpOut v_in) : TARGET
{
	// POINT sampling: stretch zones replicate pixels instead of blending
	// them — hard color edges stay hard while the disparity ramp under
	// them is smooth. (Linear washed every contact into in-between
	// colors; measured/rejected as smear.) Matches render_eyes_warp.
	float4 texel = image.SampleLevel(pointSampler, v_in.uv, 0.0);
	return float4(texel.rgb, 1.0);
}

// ---- debug blits (sprite-drawn, standard pos+uv inputs) ----
struct SpriteIn {
	float4 pos : POSITION;
	float2 uv  : TEXCOORD0;
};

WarpOut VSSprite(SpriteIn v_in)
{
	WarpOut v_out;
	v_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
	v_out.uv = v_in.uv;
	return v_out;
}

float4 PSBlitRGB(WarpOut v_in) : TARGET
{
	float4 texel = image.SampleLevel(pointSampler, v_in.uv, 0.0);
	return float4(texel.rgb, 1.0);
}

float4 PSBlitA(WarpOut v_in) : TARGET
{
	float4 texel = image.SampleLevel(pointSampler, v_in.uv, 0.0);
	return float4(texel.a, texel.a, texel.a, 1.0);
}

technique Splat
{
	pass
	{
		vertex_shader = VSSplat(v_in);
		pixel_shader  = PSSplat(v_in);
	}
}

technique Warp
{
	pass
	{
		vertex_shader = VSWarp(v_in);
		pixel_shader  = PSWarp(v_in);
	}
}

technique Debug
{
	pass
	{
		vertex_shader = VSDebug(v_in);
		pixel_shader  = PSSplat(v_in);
	}
}

technique BlitRGB
{
	pass
	{
		vertex_shader = VSSprite(v_in);
		pixel_shader  = PSBlitRGB(v_in);
	}
}

technique BlitA
{
	pass
	{
		vertex_shader = VSSprite(v_in);
		pixel_shader  = PSBlitA(v_in);
	}
}

technique DebugQ
{
	pass
	{
		vertex_shader = VSDebugQ(v_in);
		pixel_shader  = PSSplat(v_in);
	}
}
